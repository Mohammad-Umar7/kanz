# Copy to backend/.env and fill in. Never commit .env.

# Google AI Studio key (https://aistudio.google.com/apikey). Image generation needs a
# project with billing enabled (Tier 1); the free tier has no image quota.
GEMINI_API_KEY=

# Google Maps Platform key with "Places API (New)" enabled. Optional: without it the
# backend uses OpenStreetMap (Overpass) for drop-off points.
GOOGLE_MAPS_API_KEY=

# Optional overrides (current ids: https://ai.google.dev/gemini-api/docs/models)
# MODEL_VISION=gemini-3.6-flash
# MODEL_TEXT=gemini-3.6-flash
# MODEL_FALLBACKS=["gemini-3.5-flash","gemini-flash-latest","gemini-3.1-flash-lite"]
# THINKING_LEVEL=low
# MODEL_IMAGE=gemini-3.1-flash-image
# MODEL_IMAGE_FALLBACK=gemini-3.1-flash-lite-image
# MODEL_EMBED=gemini-embedding-001
# IMAGE_SIZE=1K
# RATE_LIMIT_PER_MINUTE=90
# PUBLIC_BASE_URL=https://kanz.example.com
# ENVIRONMENT=production
