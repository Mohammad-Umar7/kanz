  "routing": {
    "_comment": "For each scanned item: (1) a disposal-only hazard decides alone (by_hazard, in the listed hazard order); (2) otherwise the first matching by_condition rule decides; (3) otherwise by_material decides. Then every matching extras rule appends its keys. An item's first key is its primary route; primary routes of all items are listed before secondary ones.",
    "by_hazard": {
      "e_waste": ["e_waste"],
      "battery": ["battery"],
      "light_bulb": ["hazardous"],
      "aerosol": ["hazardous"],
      "chemical": ["hazardous"],
      "medicine": ["hazardous"],
      "broken_glass": ["hazardous"]
    },
    "by_condition": [
      {
        "id": "textile_wearable",
        "when": {"category": ["textile"], "min_quality": 3, "no_hazards": true},
        "keys": ["textile_donation", "textile_recycling"]
      },
      {
        "id": "textile_worn_out",
        "when": {"category": ["textile"]},
        "keys": ["textile_recycling"]
      }
    ],
    "by_material": {
      "glass": ["glass"],
      "plastic": ["plastic"],
      "paper": ["paper"],
      "metal": ["metal"],
      "textile": ["textile_recycling"],
      "wood": ["wood"],
      "electronics": ["e_waste"],
      "hazardous": ["hazardous"],
      "organic": [],
      "other": ["general_recycling"]
    },
    "extras": [
      {
        "id": "reusable_in_good_condition",
        "when": {"category": ["wood", "other"], "min_quality": 4, "no_hazards": true, "reuse_level": ["high"], "is_raw_material": false},
        "keys": ["donation"]
      }
    ]
  },
  "osm": {
    "_comment": "How OpenStreetMap features are read. material_tags: recycling:<suffix>=yes -> the material category the point accepts (shown as accepted_materials). known_operators: names that identify a bin's purpose when the feature lists no materials itself.",
    "material_tags": {
      "glass": ["glass", "glass_bottles"],
      "plastic": ["plastic", "plastic_bottles", "plastic_packaging", "plastic_bags", "PET"],
      "paper": ["paper", "cardboard", "newspaper", "magazines", "paper_packaging", "beverage_cartons"],
      "metal": ["cans", "scrap_metal", "aluminium", "metal"],
      "textile": ["clothes", "shoes", "textiles"],
      "wood": ["wood"],
      "electronics": ["electrical_items", "electrical_appliances", "small_appliances", "small_electrical_appliances", "mobile_phones", "computers", "hard_drives"],
      "hazardous": ["batteries", "car_batteries", "hazardous_waste", "fluorescent_tubes", "low_energy_bulbs", "paint", "engine_oil"],
      "organic": ["green_waste", "organic", "cooking_oil"]
    },
    "known_operators": [
      {
        "id": "uae_charity_clothing_bins",
        "_comment": "Many charity clothing bins in the UAE are mapped only by name. The bins with these names that do carry tags are tagged recycling:clothes and recycling:shoes, so untagged ones are read the same way.",
        "pattern": "make.?a.?wish|red crescent|الهلال الأحمر",
        "implies": {"recycling:clothes": "yes", "recycling:shoes": "yes"}
      }
    ]
  }
